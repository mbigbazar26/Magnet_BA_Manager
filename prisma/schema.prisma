generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  consent   Boolean  @default(false)
  consentAt DateTime?
  consentStatus String @default("PENDING")
  consentUpdatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  groups    ContactGroupMembership[]
  consentEvents ConsentEvent[]
}

model ContactGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contacts  ContactGroupMembership[]
}

model ContactGroupMembership {
  contactId String
  groupId   String
  createdAt DateTime     @default(now())
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([contactId, groupId])
  @@index([groupId])
}

model Template {
  id         String   @id @default(cuid())
  metaId     String?  @unique
  name       String
  language   String
  category   String
  body       String
  status     String
  components Json
  updatedAt  DateTime @updatedAt
  consentSettings ConsentSettings[]
  @@unique([name, language])
}

model Message {
  id        String    @id @default(cuid())
  requestId String?   @unique
  metaId    String?   @unique
  direction String
  phone     String
  body      String
  status    String
  error     String?
  purpose   String    @default("STANDARD")
  consentRequest Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([phone, createdAt])
  @@index([createdAt])
}

model ConsentSettings {
  id String @id @default("main")
  templateId String?
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  acceptButton Int?
  declineButton Int?
  acceptWords String[] @default([])
  declineWords String[] @default([])
  updatedAt DateTime @updatedAt
}

model ConsentEvent {
  id String @id @default(cuid())
  contactId String
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status String
  source String
  messageId String? @unique
  occurredAt DateTime
  createdAt DateTime @default(now())
  @@index([contactId, occurredAt])
}

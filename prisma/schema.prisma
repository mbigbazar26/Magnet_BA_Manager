generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  consent   Boolean  @default(false)
  consentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Template {
  id         String   @id @default(cuid())
  metaId     String?  @unique
  name       String
  language   String
  category   String
  body       String
  status     String
  components Json
  updatedAt  DateTime @updatedAt
  @@unique([name, language])
}

model Message {
  id        String    @id @default(cuid())
  requestId String?   @unique
  metaId    String?   @unique
  direction String
  phone     String
  body      String
  status    String
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([phone, createdAt])
  @@index([createdAt])
}

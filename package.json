{
  "name": "bigbazar-messaging-desk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "local": "node scripts/local.mjs",
    "build": "prisma generate && next build --webpack",
    "start": "next start -H 127.0.0.1",
    "start:cloud": "node scripts/cloud.mjs",
    "test:cloud": "node --test scripts/cloud.test.mjs scripts/auth-cloud.test.mjs",
    "test:contacts": "node --import ./scripts/test-typescript.mjs --test scripts/contacts.test.mjs",
    "test:contacts:integration": "node --import ./scripts/test-typescript.mjs --test scripts/contacts.integration.test.mjs scripts/automatic-group.integration.test.mjs",
    "relay": "node scripts/webhook-relay.mjs",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "csv-parse": "^7.0.3",
    "embedded-postgres": "17.12.0-beta.19",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "next": "^16.0.0",
    "prisma": "^6.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
